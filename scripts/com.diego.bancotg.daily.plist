<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.diego.bancotg.daily</string>
  <!-- IMPORTANTE: el proyecto vive en ~/Desktop (protegido por TCC). launchd NO
       puede abrir StandardOut/ErrPath dentro de ~/Desktop ni el shell puede
       redirigir ahí (operation not permitted -> EX_CONFIG 78). Por eso los logs
       de launchd van a ~/Library/Logs/bancotg/ y el cd se hace dentro del shell
       (no via WorkingDirectory). Ver fix 2026-06-08. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>cd "PROJECT_DIR" &amp;&amp; exec .venv/bin/python -m src.run_daily</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>56</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/diego/Library/Logs/bancotg/daily.launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/diego/Library/Logs/bancotg/daily.launchd.err</string>
</dict>
</plist>
